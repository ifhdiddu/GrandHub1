function findFruit()
    local c=plr.Character
    if not c or not c:FindFirstChild("HumanoidRootPart")then return nil end
    local best,bd=nil,math.huge
    for _,o in ipairs(workspace:GetDescendants())do
        if o:IsA("Model")and o:FindFirstChild("Handle")then
            local hn=o.Name:lower()
            for _,f in ipairs(fruitList)do
                if hn:find(f:lower(),1,true)then
                    local hrp=o:FindFirstChild("Handle")or o:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local d=(hrp.Position-c.HumanoidRootPart.Position).Magnitude
                        if d<bd then bd=d best=o end
                    end
                    break
                end
            end
        end
    end
    return best
end

function loopFruit()
    while _G.autoFruit do
        local c=plr.Character
        if c and c:FindFirstChild("HumanoidRootPart")then
            local f=findFruit()
            if f then
                stFruit.Text="Fruta: "..f.Name
                local h=f:FindFirstChild("Handle")or f:FindFirstChild("HumanoidRootPart")
                if h then
                    flyTo(h.Position,275,0)
                    task.wait(0.5)
                    pcall(function()
                        RS.Remotes.CommF_:InvokeServer("StoreFruit",f.Name)
                    end)
                    stFruit.Text="Armazenada: "..f.Name
                end
            else
                stFruit.Text="Procurando frutas..."
            end
        end
        task.wait(0.5)
    end
    stFruit.Text="Fruit parado"
end

