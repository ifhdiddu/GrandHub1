local ESTILOS={"Combat","Black Leg","Electro","Fishman Karate","Superhuman","Death Step","Sharkman Karate","Electric Claw","Dragon Talon","Godhuman","Sanguine Art"}

local function gLvl()
local d=plr:FindFirstChild("Data")
if d and d:FindFirstChild("Level")then return d.Level.Value end
return 1
end

local function gQ(lv)
local q=quests[1]
for _,v in ipairs(quests)do if v.L<=lv then q=v else break end end
return q
end

local function aIni(nm)
local ch=plr.Character
if not ch or not ch:FindFirstChild("HumanoidRootPart")then return nil end
local pos=ch.HumanoidRootPart.Position
local best,bd=nil,math.huge
for _,o in ipairs(workspace:GetDescendants())do
if o:IsA("Model")and o.Name:lower():find(nm:lower(),1,true)then
local hrp=o:FindFirstChild("HumanoidRootPart")
local hum=o:FindFirstChildOfClass("Humanoid")
if hrp and hum and hum.Health>0 then
local d=(hrp.Position-pos).Magnitude
if d<bd then bd=d best=o end
end
end
end
return best
end

local function eqp()
local ch=plr.Character
if not ch then return end
local hum=ch:FindFirstChildOfClass("Humanoid")
if not hum then return end
local eq=ch:FindFirstChildOfClass("Tool")
if eq then
for _,n in ipairs(ESTILOS)do if eq.Name:lower():find(n:lower(),1,true)then return end end
end
local bp=plr:FindFirstChild("Backpack")
if not bp then return end
for _,n in ipairs(ESTILOS)do
for _,it in ipairs(bp:GetChildren())do
if it:IsA("Tool")and it.Name:lower():find(n:lower(),1,true)then hum:EquipTool(it)return end
end
end
end

local function aceitar(q)
if not q.QN then return end
pcall(function()RS.Remotes.CommF_:InvokeServer("StartQuest",q.QN,q.QL)end)
end

local function atk()
local ch=plr.Character
if not ch then return end
local t=ch:FindFirstChildOfClass("Tool")
if t then pcall(function()t:Activate()end)end
pcall(function()game:GetService("VirtualUser"):ClickButton1(Vector2.new(0,0))end)
end

local function loopFarm()
while autoFarm do
local ch=plr.Character
if ch and ch:FindFirstChild("HumanoidRootPart")then
local lv=gLvl()
local q=gQ(lv)
if not missao or missao.L~=q.L then
missao=q
killCount=0
aceitar(q)
ultimaTent=tick()
task.wait(0.5)
end
if tick()-ultimaTent>15 then aceitar(q)ultimaTent=tick()end
local alvo=aIni(q.M)
if alvo and alvo:FindFirstChild("HumanoidRootPart")then
local hrp=alvo.HumanoidRootPart
local hum=alvo:FindFirstChildOfClass("Humanoid")
local myH=ch.HumanoidRootPart
myH.CFrame=CFrame.new(hrp.Position+Vector3.new(0,4,0.5),hrp.Position)
myH.Velocity=Vector3.new(0,0,0)
eqp()
if hum and hum.Health>0 then
for _=1,5 do atk()task.wait(0.1)end
stFarm.Text="  Nv "..lv.." | "..q.M.." | HP "..math.floor(hum.Health).." | Kills "..killCount
else killCount=killCount+1 end
else stFarm.Text="  Nv "..lv.." | Procurando "..q.M.."..." end
end
task.wait(0.1)
end
stFarm.Text="  Parado"
end

local function hasBeli()
local d=plr:FindFirstChild("Data")
if d and d:FindFirstChild("Beli")then return d.Beli.Value>=1000000 end
return false
end

local function aFru()
local ch=plr.Character
if not ch or not ch:FindFirstChild("HumanoidRootPart")then return nil end
local best,bd=nil,math.huge
for _,o in ipairs(workspace:GetDescendants())do
if o:IsA("Model")and(o.Name:lower():find("fruit")or o:FindFirstChild("Fruit"))then
local hrp=o:FindFirstChild("HumanoidRootPart")or o:FindFirstChild("Handle")
if hrp then
local d=(hrp.Position-ch.HumanoidRootPart.Position).Magnitude
if d<bd then bd=d best=o end
end
end
end
return best
end

local function loopFru()
while autoFruit do
local ch=plr.Character
if ch and ch:FindFirstChild("HumanoidRootPart")then
if not hasBeli()then stFarm.Text="  Beli insuficiente"task.wait(2)
else
local f=aFru()
if f then
stFarm.Text="  Coletando: "..f.Name
local wf=autoFarm
autoFarm=false
task.wait(0.5)
local hrpF=f:FindFirstChild("HumanoidRootPart")or f:FindFirstChild("Handle")
if hrpF then
local dst=(hrpF.Position-ch.HumanoidRootPart.Position).Magnitude
local tw=TS:Create(ch.HumanoidRootPart,TweenInfo.new(dst/80,Enum.EasingStyle.Linear),{CFrame=CFrame.new(hrpF.Position)})
tw:Play()
tw.Completed:Wait()
end
pcall(function()RS.Remotes.CommF_:InvokeServer("StoreFruit",f.Name)end)
task.wait(1)
stFarm.Text="  Armazenada: "..f.Name
if wf then autoFarm=true task.spawn(loopFarm)end
else stFarm.Text="  Procurando fruta..." end
end
end
end
task.wait(1)
end
end

