local paginas = {}
local botoesAba = {}

local function mostrarAba(nome)
    for k, p in pairs(paginas) do p.Visible = (k == nome) end
    for k, b in pairs(botoesAba) do
        if k == nome then
            TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = C.accent}):Play()
        else
            TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = C.element}):Play()
        end
    end
end

local function criarAba(nome, icone, titulo)
    local b = Instance.new("TextButton", sidebar)
    b.Size = UDim2.new(1, 0, 0, 32)
    b.BackgroundColor3 = C.element
    b.Text = "  " .. icone .. "  " .. nome
    b.TextColor3 = C.text
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    b.TextXAlignment = Enum.TextXAlignment.Left
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    botoesAba[nome] = b

    local p = Instance.new("Frame", content)
    p.Size = UDim2.new(1, 0, 1, 0)
    p.BackgroundTransparency = 1
    p.Visible = false
    paginas[nome] = p

    local h = Instance.new("TextLabel", p)
    h.Size = UDim2.new(1, 0, 0, 24)
    h.BackgroundTransparency = 1
    h.Text = titulo
    h.TextColor3 = C.text
    h.Font = Enum.Font.GothamBlack
    h.TextSize = 15
    h.TextXAlignment = Enum.TextXAlignment.Left

    local line = Instance.new("Frame", p)
    line.Size = UDim2.new(1, 0, 0, 1)
    line.Position = UDim2.new(0, 0, 0, 26)
    line.BackgroundColor3 = C.accent
    line.BorderSizePixel = 0
    line.BackgroundTransparency = 0.6

    b.MouseButton1Click:Connect(function() mostrarAba(nome) end)
    return p
end

local function criarBotao(parent, icone, texto, y, fn)
    local b = Instance.new("TextButton", parent)
    b.Size = UDim2.new(1, -20, 0, 42)
    b.Position = UDim2.new(0, 10, 0, y)
    b.BackgroundColor3 = C.element
    b.Text = ""
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)

    local str = Instance.new("UIStroke", b)
    str.Color = C.accent
    str.Thickness = 1
    str.Transparency = 0.7

    local ico = Instance.new("TextLabel", b)
    ico.Size = UDim2.new(0, 40, 1, 0)
    ico.Position = UDim2.new(0, 6, 0, 0)
    ico.BackgroundTransparency = 1
    ico.Text = icone
    ico.TextColor3 = C.text
    ico.Font = Enum.Font.GothamBold
    ico.TextSize = 18
    ico.TextXAlignment = Enum.TextXAlignment.Center

    local lbl = Instance.new("TextLabel", b)
    lbl.Size = UDim2.new(1, -56, 1, 0)
    lbl.Position = UDim2.new(0, 48, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = texto
    lbl.TextColor3 = C.text
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    b._ativo = false
    b.MouseEnter:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = C.hover}):Play()
    end)
    b.MouseLeave:Connect(function()
        if not b._ativo then
            TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = C.element}):Play()
        end
    end)
    b.MouseButton1Click:Connect(fn)
    return b, lbl
end

local function criarStatusBox(parent, y, titulo, altura)
    local box = Instance.new("Frame", parent)
    box.Size = UDim2.new(1, -20, 0, altura or 80)
    box.Position = UDim2.new(0, 10, 0, y)
    box.BackgroundColor3 = C.element
    box.BorderSizePixel = 0
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 10)

    local t = Instance.new("TextLabel", box)
    t.Size = UDim2.new(1, -24, 0, 16)
    t.Position = UDim2.new(0, 12, 0, 8)
    t.BackgroundTransparency = 1
    t.Text = titulo
    t.TextColor3 = C.accent2
    t.Font = Enum.Font.GothamBlack
    t.TextSize = 10
    t.TextXAlignment = Enum.TextXAlignment.Left

    local lbl = Instance.new("TextLabel", box)
    lbl.Size = UDim2.new(1, -24, 0, (altura or 80) - 30)
    lbl.Position = UDim2.new(0, 12, 0, 26)
    lbl.BackgroundTransparency = 1
    lbl.Text = "Parado"
    lbl.TextColor3 = C.text
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextYAlignment = Enum.TextYAlignment.Top
    lbl.TextWrapped = true
    return lbl
end

