local function gLvl()
local d=plr:FindFirstChild("Data")
if d and d:FindFirstChild("Level")then return d.Level.Value end
return 1 end

local function gQ(lv)
local q=quests[1]
for _,v in ipairs(quests)do if v.L<=lv then q=v else break end end
return q end

local function lerProgressoQuest()
local d=plr:FindFirstChild("Data")
if not d then return 0,0 end
local q=d:FindFirstChild("Quest")
if not q then return 0,0 end
local k=q:FindFirstChild("Kills")
local r=q:FindFirstChild("Requirement")
if k and r then return k.Value,r.Value end
return 0,0 end

local function voarPara(destino,vel,alturaVoo)
vel=vel or 275
alturaVoo=alturaVoo or 70
local c=plr.Character
if not c then return false end
local hrp=c:FindFirstChild("HumanoidRootPart")
if not hrp then return false end
local posInicial=hrp.Position
local alturaAlvo=posInicial.Y+alturaVoo
if math.abs(posInicial.Y-alturaAlvo)>2 then
local bp1=Instance.new("BodyPosition")
bp1.MaxForce=Vector3.new(0,1e5,0)
bp1.P=15000
bp1.D=500
bp1.Position=Vector3.new(posInicial.X,alturaAlvo,posInicial.Z)
bp1.Parent=hrp
local t0=tick()
while _G.autoF and (tick()-t0)<4 do
local y=hrp.Position.Y
if math.abs(y-alturaAlvo)<3 then break end
bp1.Position=Vector3.new(hrp.Position.X,alturaAlvo,hrp.Position.Z)
task.wait(0.01)
end
if bp1.Parent then bp1:Destroy() end
end
local bp=Instance.new("BodyPosition")
bp.MaxForce=Vector3.new(0,1e5,0)
bp.P=15000
bp.D=500
bp.Position=Vector3.new(hrp.Position.X,hrp.Position.Y,hrp.Position.Z)
bp.Parent=hrp
local bv=Instance.new("BodyVelocity")
bv.MaxForce=Vector3.new(1e5,0,1e5)
bv.P=5000
bv.Parent=hrp
local bg=Instance.new("BodyGyro")
bg.MaxTorque=Vector3.new(1e5,1e5,1e5)
bg.P=8000
bg.CFrame=CFrame.new(hrp.Position,destino)
bg.Parent=hrp
local conn
local finalizado=false
local t0=tick()
local alturaAtual=hrp.Position.Y
conn=RunService.Heartbeat:Connect(function(dt)
if not _G.autoF or not hrp.Parent or(tick()-t0)>30 then
finalizado=true
return
end
local pos=hrp.Position
local diff=destino-pos
local dXZ=Vector3.new(diff.X,0,diff.Z).Magnitude
if dXZ<5 then
finalizado=true
return
end
local fator=1
if dXZ<40 then fator=math.max(dXZ/40,0.25) end
local dirXZ=Vector3.new(diff.X,0,diff.Z).Unit
bv.Velocity=dirXZ*vel*fator
bp.Position=Vector3.new(pos.X,alturaAtual,pos.Z)
bg.CFrame=CFrame.new(pos,destino)
end)
while not finalizado and _G.autoF do
task.wait(0.01)
end
if conn then conn:Disconnect() end
if bv.Parent then bv:Destroy() end
if bg.Parent then bg:Destroy() end
if _G.autoF and hrp.Parent then
local tDescida=tick()
while _G.autoF and (tick()-tDescida)<4 do
local pos=hrp.Position
local diff=destino-pos
local dist3D=diff.Magnitude
if dist3D<4 then break end
local novoY=pos.Y+diff.Unit.Y*math.min(50,math.abs(diff.Y)+5)
if math.abs(diff.Y)<3 then novoY=destino.Y end
bp.Position=Vector3.new(destino.X,novoY,destino.Z)
task.wait(0.01)
end
end
if bp.Parent then bp:Destroy() end
return true end

local function encontrarAlvo(nome)
local c=plr.Character
if not c or not c:FindFirstChild("HumanoidRootPart")then return nil end
local pos=c.HumanoidRootPart.Position
local best,bd=nil,math.huge
local pasta=workspace:FindFirstChild("Enemies")
if pasta then
for _,o in ipairs(pasta:GetChildren())do
if o:IsA("Model")and o.Name:lower():find(nome:lower(),1,true)then
local h=o:FindFirstChild("HumanoidRootPart")
local u=o:FindFirstChildOfClass("Humanoid")
if h and u and u.Health>0 then
local d=(h.Position-pos).Magnitude
if d<bd then bd=d best=o end
end end end end
if best then return best end
for _,o in ipairs(workspace:GetDescendants())do
if o:IsA("Model")and o.Name:lower():find(nome:lower(),1,true)then
local h=o:FindFirstChild("HumanoidRootPart")
local u=o:FindFirstChildOfClass("Humanoid")
if h and u and u.Health>0 then
local d=(h.Position-pos).Magnitude
if d<bd then bd=d best=o end
end end end
return best end

local function encontrarEstilo()
local bp=plr:FindFirstChild("Backpack")
if not bp then return nil end
for _,it in ipairs(bp:GetChildren())do
if it:IsA("Tool")then
for _,n in ipairs(ES)do
if it.Name:lower():find(n:lower(),1,true)then return it end
end
end
end
return nil end

local function equipar()
local c=plr.Character
if not c then return nil end
local u=c:FindFirstChildOfClass("Humanoid")
if not u then return nil end
local e=c:FindFirstChildOfClass("Tool")
if e then
for _,n in ipairs(ES)do
if e.Name:lower():find(n:lower(),1,true)then return e.Name end
end
end
local f=encontrarEstilo()
if not f then return nil end
for _=1,3 do
pcall(function() u:EquipTool(f) end)
task.wait(0.15)
local chk=c:FindFirstChild(f.Name)
if chk and chk:IsA("Tool")then return f.Name end
end
return f.Name end

local function atacarComDano(alvo)
local c=plr.Character
if not c then return end
local u=alvo:FindFirstChildOfClass("Humanoid")
local h=alvo:FindFirstChild("HumanoidRootPart")
if not u or not h then return end
local t=c:FindFirstChildOfClass("Tool")
if t then pcall(function() t:Activate() end) end
pcall(function() RS.Remotes.CommF_:InvokeServer("Attack",true) end)
pcall(function() VIM:ClickButton1(Vector2.new(0,0)) end)
pcall(function()
VIM:SendMouseButtonEvent(0,0,0,true,game,1)
task.wait(0.01)
VIM:SendMouseButtonEvent(0,0,0,false,game,1)
end)
if u.Health>=u.MaxHealth then
pcall(function() u:TakeDamage(5) end)
end
end

local function garantirEstilo()
local c=plr.Character
if not c then return end
local e=c:FindFirstChildOfClass("Tool")
if e then
for _,n in ipairs(ES)do
if e.Name:lower():find(n:lower(),1,true)then return end
end
end
equipar()
end

