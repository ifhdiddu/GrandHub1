function loopFarm()
    while _G.autoFarm do
        local c=plr.Character
        if c and c:FindFirstChild("HumanoidRootPart")and c:FindFirstChildOfClass("Humanoid")then
            local lv=getLevel()
            local q=getQuestByLevel(lv)
            if not _G.currentQuest or _G.currentQuest.L~=q.L then
                _G.currentQuest=q
                _G.killCount=0
                local npcPos=NPCs[q.QN]
                if npcPos then
                    stFarm.Text="Nv "..lv.." | Voando ate "..q.QN
                    flyTo(Vector3.new(npcPos.X,npcPos.Y+10,npcPos.Z),275,70)
                    stFarm.Text="Nv "..lv.." | Aceitando missao..."
                    task.wait(1.5)
                end
                pcall(function() RS.Remotes.CommF_:InvokeServer("StartQuest",q.QN,q.QL) end)
                _G.lastQuestAttempt=tick()
                task.wait(1)
            end

            local kAtual,kNec=getQuestProgress()
            if kAtual==0 then kAtual=_G.killCount end
            if kNec==0 then kNec=q.KL or 5 end

            if kAtual>=kNec and kNec>0 then
                stFarm.Text="Missao completa! ("..kAtual.."/"..kNec..")"
                _G.currentQuest=nil
                _G.killCount=0
                task.wait(2)
            else
                local target=findEnemy(q.M)
                if target and target:FindFirstChild("HumanoidRootPart")then
                    local h=target.HumanoidRootPart
                    local u=target:FindFirstChildOfClass("Humanoid")
                    local c2=plr.Character
                    local hum=c2 and c2:FindFirstChildOfClass("Humanoid")
                    local hrp=c2 and c2:FindFirstChild("HumanoidRootPart")
                    if u and u.Health>0 and hum and hrp then
                        stFarm.Text="Nv "..lv.." | Voando ate "..q.M
                        flyTo(h.Position+Vector3.new(0,10,0),275,30)
                        local bp=Instance.new("BodyPosition")
                        bp.MaxForce=Vector3.new(1e5,1e5,1e5)
                        bp.P=30000
                        bp.D=1500
                        bp.Position=h.Position+Vector3.new(0,10,0)
                        bp.Parent=hrp
                        local bg=Instance.new("BodyGyro")
                        bg.MaxTorque=Vector3.new(1e5,1e5,1e5)
                        bg.P=15000
                        bg.CFrame=CFrame.new(hrp.Position,h.Position)
                        bg.Parent=hrp
                        hum.PlatformStand=true
                        task.wait(0.1)
                        equipStyle()
                        task.wait(0.3)
                        local cPos
                        cPos=RunService.Heartbeat:Connect(function()
                            if not _G.autoFarm or not h.Parent or not hrp.Parent then return end
                            bp.Position=h.Position+Vector3.new(0,10,0)
                            bg.CFrame=CFrame.new(hrp.Position,h.Position)
                            hrp.Velocity=Vector3.new(0,0,0)
                            if hum.Parent then hum.PlatformStand=true end
                            ensureStyle()
                        end)
                        local cAtk
                        cAtk=RunService.Heartbeat:Connect(function()
                            if not _G.autoFarm or not u.Parent or u.Health<=0 then return end
                            attack(target)
                        end)
                        local t0=tick()
                        while _G.autoFarm and u.Parent and u.Health>0 and (tick()-t0)<30 do
                            local kA,kN=getQuestProgress()
                            if kA==0 then kA=_G.killCount end
                            if kN==0 then kN=q.KL or 5 end
                            stFarm.Text="Nv "..lv.." | "..q.M.." | HP "..math.floor(u.Health).." | Kills "..kA.."/"..kN
                            task.wait(0.1)
                        end
                        if cAtk then cAtk:Disconnect() end
                        if cPos then cPos:Disconnect() end
                        if bp.Parent then bp:Destroy() end
                        if bg.Parent then bg:Destroy() end
                        if hum.Parent then
                            hum.PlatformStand=false
                            hum.WalkSpeed=16
                        end
                        if u.Parent and u.Health<=0 then
                            _G.killCount=_G.killCount+1
                            task.wait(0.5)
                        end
                    end
                else
                    stFarm.Text="Nv "..lv.." | Procurando "..q.M
                end
            end
        else
            stFarm.Text="Sem personagem"
        end
        task.wait(0.1)
    end
    stFarm.Text="Parado"
end

