    local d=plr:FindFirstChild("Data")
    if d and d:FindFirstChild("Level")then return d.Level.Value end
    return 1
end

function getQuestByLevel(lv)
    local q=quests[1]
    for _,v in ipairs(quests)do
        if v.L<=lv then q=v else break end
    end
    return q
end

function getQuestProgress()
    local d=plr:FindFirstChild("Data")
    if not d then return 0,0 end
    local q=d:FindFirstChild("Quest")
    if not q then return 0,0 end
    local k=q:FindFirstChild("Kills")
    local r=q:FindFirstChild("Requirement")
    if k and r then return k.Value,r.Value end
    return 0,0
end

function findEnemy(name)
    local c=plr.Character
    if not c or not c:FindFirstChild("HumanoidRootPart")then return nil end
    local pos=c.HumanoidRootPart.Position
    local best,bd=nil,math.huge
    local folder=workspace:FindFirstChild("Enemies")
    if folder then
        for _,o in ipairs(folder:GetChildren())do
            if o:IsA("Model")and o.Name:lower():find(name:lower(),1,true)then
                local h=o:FindFirstChild("HumanoidRootPart")
                local u=o:FindFirstChildOfClass("Humanoid")
                if h and u and u.Health>0 then
                    local d=(h.Position-pos).Magnitude
                    if d<bd then bd=d best=o end
                end
            end
        end
    end
    if best then return best end
    for _,o in ipairs(workspace:GetDescendants())do
        if o:IsA("Model")and o.Name:lower():find(name:lower(),1,true)then
            local h=o:FindFirstChild("HumanoidRootPart")
            local u=o:FindFirstChildOfClass("Humanoid")
            if h and u and u.Health>0 then
                local d=(h.Position-pos).Magnitude
                if d<bd then bd=d best=o end
            end
        end
    end
    return best
end

function findStyle()
    local bp=plr:FindFirstChild("Backpack")
    if not bp then return nil end
    for _,it in ipairs(bp:GetChildren())do
        if it:IsA("Tool")then
            for _,n in ipairs(ES)do
                if it.Name:lower():find(n:lower(),1,true)then return it end
            end
        end
    end
    return nil
end

function equipStyle()
    local c=plr.Character
    if not c then return nil end
    local u=c:FindFirstChildOfClass("Humanoid")
    if not u then return nil end
    local e=c:FindFirstChildOfClass("Tool")
    if e then
        for _,n in ipairs(ES)do
            if e.Name:lower():find(n:lower(),1,true)then return e.Name end
        end
    end
    local f=findStyle()
    if not f then return nil end
    for _=1,3 do
        pcall(function() u:EquipTool(f) end)
        task.wait(0.1)
        local chk=c:FindFirstChild(f.Name)
        if chk and chk:IsA("Tool")then return f.Name end
    end
    return f.Name
end

function ensureStyle()
    local c=plr.Character
    if not c then return end
    local e=c:FindFirstChildOfClass("Tool")
    if e then
        for _,n in ipairs(ES)do
            if e.Name:lower():find(n:lower(),1,true)then return end
        end
    end
    equipStyle()
end

function attack(target)
    local c=plr.Character
    if not c then return end
    local u=target:FindFirstChildOfClass("Humanoid")
    local h=target:FindFirstChild("HumanoidRootPart")
    if not u or not h then return end
    local t=c:FindFirstChildOfClass("Tool")
    if t then pcall(function() t:Activate() end) end
    pcall(function() RS.Remotes.CommF_:InvokeServer("Attack",true) end)
    pcall(function() VIM:ClickButton1(Vector2.new(0,0)) end)
    pcall(function()
        VIM:SendMouseButtonEvent(0,0,0,true,game,1)
        VIM:SendMouseButtonEvent(0,0,0,false,game,1)
    end)
    if u.Health>=u.MaxHealth then
        pcall(function() u:TakeDamage(5) end)
    end
end

function flyTo(dest,vel,altura)
    vel=vel or _G.farmSpeed
    altura=altura or 70
    local c=plr.Character
    if not c then return false end
    local hrp=c:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local pI=hrp.Position
    local altAlvo=pI.Y+altura
    if math.abs(pI.Y-altAlvo)>2 then
        local bp1=Instance.new("BodyPosition")
        bp1.MaxForce=Vector3.new(0,1e5,0)
        bp1.P=15000
        bp1.D=500
        bp1.Position=Vector3.new(pI.X,altAlvo,pI.Z)
        bp1.Parent=hrp
        local t0=tick()
        while (tick()-t0)<4 do
            if math.abs(hrp.Position.Y-altAlvo)<3 then break end
            bp1.Position=Vector3.new(hrp.Position.X,altAlvo,hrp.Position.Z)
            task.wait(0.01)
        end
        if bp1.Parent then bp1:Destroy() end
    end
    local bp=Instance.new("BodyPosition")
    bp.MaxForce=Vector3.new(0,1e5,0)
    bp.P=15000
    bp.D=500
    bp.Position=hrp.Position
    bp.Parent=hrp
    local bv=Instance.new("BodyVelocity")
    bv.MaxForce=Vector3.new(1e5,0,1e5)
    bv.P=5000
    bv.Parent=hrp
    local bg=Instance.new("BodyGyro")
    bg.MaxTorque=Vector3.new(1e5,1e5,1e5)
    bg.P=8000
    bg.CFrame=CFrame.new(hrp.Position,dest)
    bg.Parent=hrp
    local conn
    local done=false
    local t0=tick()
    local altAtual=hrp.Position.Y
    conn=RunService.Heartbeat:Connect(function()
        if not hrp.Parent or (tick()-t0)>30 then done=true return end
        local pos=hrp.Position
        local diff=dest-pos
        local dXZ=Vector3.new(diff.X,0,diff.Z).Magnitude
        if dXZ<5 then done=true return end
        local fator=1
        if dXZ<40 then fator=math.max(dXZ/40,0.25) end
        bv.Velocity=Vector3.new(diff.X,0,diff.Z).Unit*vel*fator
        bp.Position=Vector3.new(pos.X,altAtual,pos.Z)
        bg.CFrame=CFrame.new(pos,dest)
    end)
    while not done do task.wait(0.01) end
    if conn then conn:Disconnect() end
    if bv.Parent then bv:Destroy() end
    if bg.Parent then bg:Destroy() end
    if hrp.Parent then
        local tDesc=tick()
        while (tick()-tDesc)<4 do
            local pos=hrp.Position
            local diff=dest-pos
            if diff.Magnitude<4 then break end
            local nY=pos.Y+diff.Unit.Y*math.min(50,math.abs(diff.Y)+5)
            if math.abs(diff.Y)<3 then nY=dest.Y end
            bp.Position=Vector3.new(dest.X,nY,dest.Z)
            task.wait(0.01)
        end
    end
    if bp.Parent then bp:Destroy() end
    return true
end

