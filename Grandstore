function loopFarm()
while _G.autoF do
local c=plr.Character
if c and c:FindFirstChild("HumanoidRootPart")and c:FindFirstChildOfClass("Humanoid")then
local lv=gLvl()
local q=gQ(lv)
if not _G.missao or _G.missao.L~=q.L then
_G.missao=q
_G.kC=0
local npcPos=NPCs[q.QN]
if npcPos then
stFarm.Text="Nv "..lv.." | Voando ate NPC "..q.QN
voarPara(Vector3.new(npcPos.X,npcPos.Y+10,npcPos.Z),275,70)
stFarm.Text="Nv "..lv.." | Aceitando missao..."
task.wait(1.5)
end
pcall(function() RS.Remotes.CommF_:InvokeServer("StartQuest",q.QN,q.QL) end)
_G.uT=tick()
task.wait(1)
end
local kAtual,kNec=lerProgressoQuest()
if kAtual==0 then kAtual=_G.kC end
if kNec==0 then kNec=q.KL or 5 end
if kAtual>=kNec and kNec>0 then
stFarm.Text="Missao completa! ("..kAtual.."/"..kNec..")"
_G.missao=nil
_G.kC=0
task.wait(2)
else
local alvo=encontrarAlvo(q.M)
if alvo and alvo:FindFirstChild("HumanoidRootPart")then
local h=alvo.HumanoidRootPart
local u=alvo:FindFirstChildOfClass("Humanoid")
local c2=plr.Character
local hum=c2 and c2:FindFirstChildOfClass("Humanoid")
local hrp=c2 and c2:FindFirstChild("HumanoidRootPart")
if u and u.Health>0 and hum and hrp then
stFarm.Text="Nv "..lv.." | Voando ate "..q.M
voarPara(h.Position+Vector3.new(0,10,0),275,30)
local bp=Instance.new("BodyPosition")
bp.MaxForce=Vector3.new(1e5,1e5,1e5)
bp.P=30000
bp.D=1500
bp.Position=h.Position+Vector3.new(0,10,0)
